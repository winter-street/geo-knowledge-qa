# 服务端口
PORT=3000

# DeepSeek API (V4 系列，OpenAI 兼容)
# deepseek-v4-flash: 非思考模式（推荐用于问答）
# deepseek-v4-pro:   思考模式（复杂推理）
DEEPSEEK_API_KEY=sk-placeholder
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# 通义千问 API（备用模型，可选）
TONGYI_API_KEY=sk-your-tongyi-key-here
TONGYI_MODEL=qwen-plus
TONGYI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 检索配置
RETRIEVAL_TOP_K=5

# JWT 密钥（生产环境请更换为随机字符串）
JWT_SECRET=your-jwt-secret-here
